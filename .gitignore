# --- Environment ---
.env
.env.*
!.env.example

# --- Python / uv ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Database (recreated + seeded on startup) ---
backend/data/*.db
backend/data/*.db-*
!backend/data/.gitkeep

# --- Node / Vite ---
node_modules/
dist/
*.tsbuildinfo
.vite/

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*

# --- Local AI models (downloaded on first use) ---
backend/data/models/
