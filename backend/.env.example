# Copy to backend/.env and adjust if needed. Every value has a default, so .env is optional.

# SQLite file (created on first start, kept after restarts)
# DATABASE_URL=sqlite:///data/corvalis.db

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Fill an empty database with realistic Corvalis sample data on startup
SEED_ON_STARTUP=true

# Local AI assistant (no API key, runs on your machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
