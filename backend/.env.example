# Copy to backend/.env and adjust if needed. Every value has a default, so .env is optional.

# SQLite file (created on first start, kept after restarts)
# DATABASE_URL=sqlite:///data/corvalis.db

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Fill an empty database with realistic Corvalis sample data on startup
SEED_ON_STARTUP=true

# ---------------------------------------------------------------- Local AI assistant (P1)
# Everything runs on this machine: no API key, nothing leaves the laptop.

# LLM that writes the answer (Ollama, uses the GPU when there is one)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Retrieval models (fastembed / ONNX, run on the CPU so the GPU stays free for the LLM).
# Must be multilingual: employees ask in French, Dutch or English, the policies are in English.
# Chosen after the retrieval evaluation (reports/rag-evaluation.md): 100% top-1 in EN/FR/NL, ~50 ms.
# Lighter alternative (0.2 GB): sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 + RETRIEVAL_MODE=dense_rerank
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Only used by the *_rerank modes
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
# Where the models are downloaded the first time (kept out of git)
MODELS_CACHE_DIR=data/models

# dense | dense_rerank | sparse | sparse_rerank | hybrid | hybrid_rerank (see reports/rag-evaluation.md)
RETRIEVAL_MODE=dense
# Chunks given to the LLM, and candidates passed to the reranker
RETRIEVAL_TOP_K=3
RERANK_CANDIDATES=5
# Below this top-1 similarity the question is treated as off-topic (offer to ask HR).
# Kept low on purpose: borderline questions go to the LLM, which is told to answer only from the extracts.
RETRIEVAL_MIN_SCORE=0.75
